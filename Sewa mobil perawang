<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mustang Rent Car - Rental Mobil Perawang Siak</title>
    
    <!-- SEO Meta Tags -->
    <meta name="description" content="Sewa & Rental Mobil Perawang Siak terpercaya. Menyediakan unit Avanza, Xenia, Brio, Innova Reborn. Lepas kunci atau dengan supir. Verifikasi online cepat.">
    <meta name="keywords" content="rental mobil perawang, sewa mobil perawang, rental mobil tualang siak, mustang rent car perawang">
    <meta name="author" content="Mustang Rent Car">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts (Poppins) -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body { font-family: 'Poppins', sans-serif; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col selection:bg-amber-500 selection:text-slate-950">

    <!-- HEADER / NAVIGASI -->
    <header class="bg-slate-950/90 backdrop-blur-md border-b border-slate-800/80 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
            <a href="#" class="flex items-center space-x-3 group">
                <div class="bg-amber-500 text-slate-950 font-black p-2 rounded-xl text-xl tracking-wider shadow-lg shadow-amber-500/20 group-hover:bg-amber-400 transition">
                    MUSTANG
                </div>
                <div>
                    <h1 class="text-base sm:text-lg font-bold leading-none text-white tracking-wide">MUSTANG RENT CAR</h1>
                    <p class="text-[11px] text-amber-400 font-medium">Rental Mobil Perawang & Siak</p>
                </div>
            </a>
            
            <div class="flex items-center space-x-2">
                <button onclick="toggleComplaintModal()" class="text-xs bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 px-3 py-2 rounded-xl transition flex items-center gap-1.5">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <span class="hidden sm:inline">Pengaduan</span>
                </button>
                <button onclick="toggleAdminModal()" class="text-xs bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-700/80 px-3 py-2 rounded-xl transition flex items-center gap-1.5 shadow-sm">
                    <i class="fa-solid fa-lock text-amber-400"></i>
                    <span class="hidden sm:inline">Admin</span>
                </button>
                <a href="https://wa.me/6281234567890?text=Halo%20Mustang%20Rent%20Car,%20saya%20ingin%20tanya%20sewa%20mobil" target="_blank" class="text-xs bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-3.5 py-2 rounded-xl transition flex items-center gap-1.5 shadow-lg shadow-amber-500/20">
                    <i class="fa-brands fa-whatsapp text-base"></i>
                    <span>Hubungi WA</span>
                </a>
            </div>
        </div>
    </header>

    <!-- HERO BANNER -->
    <section class="relative bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 py-12 sm:py-16 px-4 border-b border-slate-800/80">
        <div class="max-w-4xl mx-auto text-center space-y-4">
            <span class="bg-amber-500/10 text-amber-400 border border-amber-500/30 text-xs px-4 py-1.5 rounded-full font-semibold inline-block tracking-wide">
                📍 Jasa Rental Mobil Terpercaya di Perawang, Siak
            </span>
            <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
                Sewa Mobil Murah & Verifikasi <span class="text-amber-400 underline decoration-amber-500/40">Online Cepat</span>
            </h2>
            <p class="text-xs sm:text-sm text-slate-400 max-w-2xl mx-auto leading-relaxed">
                Pilih tanggal sewa langsung, verifikasi identitas (KTP, SIM & Selfie) secara online, dan tanda tangani surat perjanjian sewa tanpa ribet.
            </p>
            
            <div class="pt-3 flex flex-wrap justify-center gap-3">
                <a href="#katalog" class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-6 py-3 rounded-xl transition shadow-xl shadow-amber-500/20 text-xs sm:text-sm flex items-center gap-2">
                    <i class="fa-solid fa-car"></i> Pilih Armada & Tanggal Sewa
                </a>
                <button onclick="toggleComplaintModal()" class="bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700/80 font-medium px-6 py-3 rounded-xl transition text-xs sm:text-sm flex items-center gap-2">
                    <i class="fa-solid fa-headset text-amber-400"></i> Layanan Pengaduan
                </button>
            </div>
        </div>
    </section>

    <!-- KATALOG MOBIL / ARMADA -->
    <main id="katalog" class="max-w-7xl mx-auto px-4 py-12 flex-grow w-full">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
            <div>
                <h3 class="text-2xl font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-car-side text-amber-400"></i> Pilihan Armada & Sewa Per Hari
                </h3>
                <p class="text-xs text-slate-400 mt-1">Pilih kendaraan untuk langsung mengisi formulir sewa & tanggal</p>
            </div>

            <!-- SEARCH BAR & FILTER TRANSMISI -->
            <div class="flex flex-col sm:flex-row gap-2.5">
                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-xs"></i>
                    <input type="text" id="searchInput" oninput="handleSearch()" placeholder="Cari unit (Xenia, Avanza...)" class="bg-slate-900 border border-slate-800 rounded-xl pl-8 pr-3 py-2 text-xs text-white focus:outline-none focus:border-amber-500 w-full sm:w-52">
                </div>
                <div class="flex gap-1.5 bg-slate-900 p-1 border border-slate-800 rounded-xl">
                    <button onclick="filterCars('all')" class="filter-btn active text-xs px-3 py-1.5 rounded-lg bg-amber-500 text-slate-950 font-bold transition">Semua</button>
                    <button onclick="filterCars('Manual')" class="filter-btn text-xs px-3 py-1.5 rounded-lg text-slate-400 hover:text-white transition">Manual</button>
                    <button onclick="filterCars('Matic')" class="filter-btn text-xs px-3 py-1.5 rounded-lg text-slate-400 hover:text-white transition">Matic</button>
                </div>
            </div>
        </div>

        <!-- GRID KATALOG MOBIL -->
        <div id="carGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Data mobil dimuat dari JavaScript -->
        </div>
    </main>

    <!-- FOOTER -->
    <footer class="bg-slate-950 border-t border-slate-800 text-slate-400 py-8 text-xs mt-auto">
        <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
                <h4 class="text-white font-bold text-base mb-2">MUSTANG RENT CAR</h4>
                <p class="leading-relaxed">Solusi rental mobil terpercaya di Perawang, Siak, Riau. Melayani sewa harian, lepas kunci, dan dengan driver profesional.</p>
            </div>
            <div>
                <h4 class="text-white font-bold text-base mb-2">LOKASI & KONTAK</h4>
                <p class="mb-1"><i class="fa-solid fa-location-dot text-amber-400 mr-2"></i> Perawang, Kec. Tualang, Siak, Riau</p>
                <p class="mb-1"><i class="fa-brands fa-whatsapp text-amber-400 mr-2"></i> 0812-3456-7890</p>
                <p><i class="fa-solid fa-clock text-amber-400 mr-2"></i> Operasional 24 Jam</p>
            </div>
            <div>
                <h4 class="text-white font-bold text-base mb-2">LAYANAN KONSUMEN</h4>
                <p class="mb-1"><a href="javascript:void(0)" onclick="toggleComplaintModal()" class="text-amber-400 hover:underline">Formulir Pengaduan Pelanggan</a></p>
                <p class="text-slate-500">Aman, cepat, dan transparan.</p>
            </div>
        </div>
        <div class="max-w-7xl mx-auto px-4 mt-6 pt-4 border-t border-slate-900 text-center text-slate-500">
            &copy; Mustang Rent Car Perawang. All Rights Reserved.
        </div>
    </footer>

    <!-- MODAL FORMULIR SEWA ONLINE + SURAT PERJANJIAN & UPLOAD IDENTITAS -->
    <div id="bookingModal" class="fixed inset-0 bg-slate-950/90 backdrop-blur-md z-50 overflow-y-auto p-4 hidden">
        <div class="max-w-2xl mx-auto bg-slate-900 border border-slate-800 rounded-2xl p-6 my-6 relative">
            <button onclick="closeBookingModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>

            <div class="border-b border-slate-800 pb-4 mb-6">
                <span class="text-amber-400 text-[10px] font-bold uppercase tracking-widest">Surat Perjanjian & Verifikasi Online</span>
                <h3 class="text-xl font-bold text-white mt-1" id="modalCarName">Formulir Sewa Mobil</h3>
                <p class="text-xs text-slate-400">Isi data tanggal sewa dan verifikasi identitas Anda secara lengkap</p>
            </div>

            <form onsubmit="submitBookingAgreement(event)" class="space-y-5">
                <input type="hidden" id="bookCarId">
                <input type="hidden" id="bookCarPrice">

                <!-- TANGGAL SEWA -->
                <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-3">
                    <h4 class="text-xs font-bold text-amber-400 uppercase tracking-wider"><i class="fa-solid fa-calendar-days mr-1.5"></i> 1. Pilih Tanggal Sewa</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="text-xs text-slate-400 mb-1 block">Tanggal Mulai Sewa</label>
                            <input type="date" id="startDate" required onchange="calculateRentalDays()" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-500">
                        </div>
                        <div>
                            <label class="text-xs text-slate-400 mb-1 block">Tanggal Selesai Sewa</label>
                            <input type="date" id="endDate" required onchange="calculateRentalDays()" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-500">
                        </div>
                    </div>
                    <div class="flex justify-between items-center bg-slate-900 p-3 rounded-lg border border-slate-800/80 text-xs mt-2">
                        <span>Durasi Sewa: <strong id="totalDaysText" class="text-amber-400">1 Hari</strong></span>
                        <span>Total Biaya: <strong id="totalCostText" class="text-amber-400 text-sm">Rp 0</strong></span>
                    </div>
                </div>

                <!-- DATA DIRI PENYEWA -->
                <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-3">
                    <h4 class="text-xs font-bold text-amber-400 uppercase tracking-wider"><i class="fa-solid fa-user mr-1.5"></i> 2. Data Identitas Penyewa</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="text-xs text-slate-400 mb-1 block">Nama Lengkap (Sesuai KTP)</label>
                            <input type="text" id="renterName" required placeholder="Nama Penyewa" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-500">
                        </div>
                        <div>
                            <label class="text-xs text-slate-400 mb-1 block">No. WhatsApp/HP</label>
                            <input type="tel" id="renterPhone" required placeholder="08xxxxxxxxxx" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-500">
                        </div>
                    </div>
                    <div>
                        <label class="text-xs text-slate-400 mb-1 block">Alamat Tempat Tinggal (Perawang / Domisili)</label>
                        <input type="text" id="renterAddress" required placeholder="Alamat lengkap" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-500">
                    </div>
                </div>

                <!-- UPLOAD IDENTITAS & VERIFIKASI WAJAH -->
                <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-3">
                    <h4 class="text-xs font-bold text-amber-400 uppercase tracking-wider"><i class="fa-solid fa-id-card mr-1.5"></i> 3. Unggah Dokumen & Foto Diri</h4>
                    <p class="text-[11px] text-slate-400">Sistem akan melakukan pemindaian wajah. Foto selfie harus cocok dengan wajah di KTP/SIM.</p>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <!-- UPLOAD KTP -->
                        <div class="bg-slate-900 p-3 rounded-lg border border-slate-800 text-center">
                            <label class="text-[11px] text-slate-300 font-semibold mb-1 block">Foto E-KTP Asli</label>
                            <input type="file" id="ktpImage" accept="image/*" required onchange="previewUpload('ktp', event)" class="hidden">
                            <button type="button" onclick="document.getElementById('ktpImage').click()" class="w-full bg-slate-800 hover:bg-slate-700 text-xs py-2 rounded border border-slate-700 text-slate-300">
                                <i class="fa-solid fa-upload mr-1"></i> Pilih Foto KTP
                            </button>
                            <div id="ktpPreview" class="mt-2 hidden text-[10px] text-emerald-400">✔ KTP Terunggah</div>
                        </div>

                        <!-- UPLOAD SIM -->
                        <div class="bg-slate-900 p-3 rounded-lg border border-slate-800 text-center">
                            <label class="text-[11px] text-slate-300 font-semibold mb-1 block">Foto SIM A Aktif</label>
                            <input type="file" id="simImage" accept="image/*" required onchange="previewUpload('sim', event)" class="hidden">
                            <button type="button" onclick="document.getElementById('simImage').click()" class="w-full bg-slate-800 hover:bg-slate-700 text-xs py-2 rounded border border-slate-700 text-slate-300">
                                <i class="fa-solid fa-upload mr-1"></i> Pilih Foto SIM
                            </button>
                            <div id="simPreview" class="mt-2 hidden text-[10px] text-emerald-400">✔ SIM Terunggah</div>
                        </div>

                        <!-- UPLOAD SELFIE DENGAN KTP -->
                        <div class="bg-slate-900 p-3 rounded-lg border border-slate-800 text-center">
                            <label class="text-[11px] text-slate-300 font-semibold mb-1 block">Foto Selfie + KTP</label>
                            <input type="file" id="selfieImage" accept="image/*" required onchange="previewUpload('selfie', event)" class="hidden">
                            <button type="button" onclick="document.getElementById('selfieImage').click()" class="w-full bg-slate-800 hover:bg-slate-700 text-xs py-2 rounded border border-slate-700 text-slate-300">
                                <i class="fa-solid fa-camera mr-1"></i> Ambil Foto Diri
                            </button>
                            <div id="selfiePreview" class="mt-2 hidden text-[10px] text-emerald-400">✔ Selfie Terunggah</div>
                        </div>
                    </div>

                    <!-- NOTIFIKASI ERROR / KETIDAKCOCOKAN -->
                    <div id="faceMatchAlert" class="hidden bg-rose-500/10 border border-rose-500/40 text-rose-400 p-3 rounded-lg text-xs flex items-center gap-2">
                        <i class="fa-solid fa-triangle-exclamation text-base"></i>
                        <span>Peringatan: Foto wajah pada KTP dan Foto Selfie tidak cocok atau kurang jelas. Pengajuan akan ditolak jika foto buram.</span>
                    </div>
                </div>

                <!-- SURAT PERJANJIAN SEWA DIGITAL -->
                <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
                    <h4 class="text-xs font-bold text-amber-400 uppercase tracking-wider"><i class="fa-solid fa-file-contract mr-1.5"></i> 4. Surat Perjanjian Sewa</h4>
                    <div class="h-28 overflow-y-auto bg-slate-900 p-3 rounded-lg border border-slate-800 text-[11px] text-slate-400 space-y-1.5 leading-relaxed">
                        <p class="text-white font-bold">SYARAT & KETENTUAN MUSTANG RENT CAR PERAWANG:</p>
                        <p>1. Penyewa bertanggung jawab penuh atas keselamatan kendaraan selama masa sewa.</p>
                        <p>2. Kendaraan tidak diperkenankan dipindah tangankan atau digunakan untuk tindakan melanggar hukum.</p>
                        <p>3. Keterlambatan pengembalian unit dikenakan denda sesuai tarif jam berlebih.</p>
                        <p>4. Identitas KTP, SIM A, serta Foto Diri yang diserahkan adalah benar milik penyewa asli.</p>
                    </div>
                    <label class="flex items-center gap-2 pt-2 cursor-pointer">
                        <input type="checkbox" required id="agreeTerms" class="rounded text-amber-500 focus:ring-amber-500 bg-slate-900 border-slate-800">
                        <span class="text-xs text-slate-300 font-medium">Saya membaca & menyetujui seluruh isi Surat Perjanjian Sewa di atas.</span>
                    </label>
                </div>

                <button type="submit" class="w-full bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold py-3 rounded-xl transition text-xs shadow-lg shadow-amber-500/20">
                    <i class="fa-brands fa-whatsapp text-sm mr-1.5"></i> Kirim Formulir & Ajukan Sewa
                </button>
            </form>
        </div>
    </div>

    <!-- MODAL PENGADUAN KONSUMEN -->
    <div id="complaintModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 relative">
            <button onclick="toggleComplaintModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
            <div class="text-center mb-5">
                <div class="w-12 h-12 bg-rose-500/10 text-rose-400 rounded-full flex items-center justify-center mx-auto mb-3">
                    <i class="fa-solid fa-headset text-xl"></i>
                </div>
                <h3 class="text-lg font-bold text-white">Layanan Pengaduan Konsumen</h3>
                <p class="text-xs text-slate-400 mt-1">Sampaikan keluhan terkait armada, driver, atau pelayanan kami</p>
            </div>
            <form onsubmit="submitComplaint(event)" class="space-y-3">
                <div>
                    <label class="text-xs text-slate-400 mb-1 block">Nama Pelanggan</label>
                    <input type="text" id="compName" required placeholder="Nama Anda" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-500">
                </div>
                <div>
                    <label class="text-xs text-slate-400 mb-1 block">Jenis Pengaduan</label>
                    <select id="compCategory" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-500">
                        <option value="Kendala Kendaraan/Mobil">Kendala Kendaraan/Mobil</option>
                        <option value="Pelayanan Driver">Pelayanan Driver</option>
                        <option value="Masalah Pembayaran/Tarif">Masalah Pembayaran/Tarif</option>
                        <option value="Lain-lain">Lain-lain</option>
                    </select>
                </div>
                <div>
                    <label class="text-xs text-slate-400 mb-1 block">Detail Pengaduan</label>
                    <textarea id="compDetail" required rows="3" placeholder="Tuliskan keluhan Anda secara jelas..." class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-500"></textarea>
                </div>
                <button type="submit" class="w-full bg-rose-600 hover:bg-rose-500 text-white font-bold py-2.5 rounded-xl transition text-xs">
                    Kirim Pengaduan via WhatsApp
                </button>
            </form>
        </div>
    </div>

    <!-- MODAL AUTH ADMIN -->
    <div id="adminAuthModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-sm w-full p-6 relative">
            <button onclick="toggleAdminModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
            <div class="text-center mb-5">
                <div class="w-12 h-12 bg-amber-500/10 text-amber-400 rounded-full flex items-center justify-center mx-auto mb-3">
                    <i class="fa-solid fa-shield-halved text-xl"></i>
                </div>
                <h3 class="text-lg font-bold text-white">Login Admin Mustang</h3>
                <p class="text-xs text-slate-400 mt-1">Masukkan PIN default: <span class="text-amber-400 font-mono font-bold">1234</span></p>
            </div>
            <form onsubmit="handleAdminLogin(event)" class="space-y-4">
                <div>
                    <input type="password" id="adminPin" placeholder="Masukkan PIN" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-center tracking-widest text-lg focus:outline-none focus:border-amber-500">
                </div>
                <button type="submit" class="w-full bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold py-3 rounded-xl transition text-xs">
                    Masuk Dashboard Admin
                </button>
            </form>
        </div>
    </div>

    <!-- MODAL DASHBOARD ADMIN -->
    <div id="adminDashboardModal" class="fixed inset-0 bg-slate-950/90 backdrop-blur-md z-50 overflow-y-auto p-4 hidden">
        <div class="max-w-3xl mx-auto bg-slate-900 border border-slate-800 rounded-2xl p-6 my-8 relative">
            <div class="flex justify-between items-center border-b border-slate-800 pb-4 mb-6">
                <div>
                    <h3 class="text-xl font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-sliders text-amber-400"></i> Dashboard Kelola Armada
                    </h3>
                    <p class="text-xs text-slate-400">Tambah, ubah status ketersediaan, atau hapus unit sewa</p>
                </div>
                <button onclick="closeAdminDashboard()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 px-3.5 py-1.5 rounded-xl text-xs font-medium">
                    Tutup Dashboard
                </button>
            </div>

            <form onsubmit="saveCar(event)" class="bg-slate-950 p-4 border border-slate-800 rounded-xl mb-8 space-y-4">
                <h4 class="text-xs font-bold text-amber-400 uppercase tracking-wider">+ Input Mobil Baru</h4>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs text-slate-400 mb-1 block">Nama / Model Mobil</label>
                        <input type="text" id="carName" required placeholder="Contoh: Daihatsu Xenia Silver" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-500">
                    </div>
                    <div>
                        <label class="text-xs text-slate-400 mb-1 block">Tahun Varian</label>
                        <input type="text" id="carYear" required placeholder="Contoh: 2016" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-500">
                    </div>
                    <div>
                        <label class="text-xs text-slate-400 mb-1 block">Transmisi</label>
                        <select id="carTransmission" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-500">
                            <option value="Manual">Manual</option>
                            <option value="Matic">Matic</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-xs text-slate-400 mb-1 block">Kapasitas Kursi</label>
                        <input type="text" id="carSeats" required placeholder="Contoh: 7 Kursi" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-500">
                    </div>
                    <div>
                        <label class="text-xs text-slate-400 mb-1 block">Harga Sewa / Hari (Rp)</label>
                        <input type="number" id="carPrice" required placeholder="Contoh: 300000" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-500">
                    </div>
                    <div>
                        <label class="text-xs text-slate-400 mb-1 block">URL Foto Mobil (Opsional)</label>
                        <input type="url" id="carImage" placeholder="https://..." class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-500">
                    </div>
                </div>
                <button type="submit" class="w-full bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold py-2.5 rounded-lg transition text-xs">
                    Simpan Unit Baru
                </button>
            </form>

            <div>
                <h4 class="text-xs font-bold text-white mb-3 uppercase tracking-wider">Daftar Armada Terdaftar</h4>
                <div id="adminCarList" class="space-y-3">
                    <!-- Ditampilkan via JS -->
                </div>
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        const defaultCars = [
            {
                id: "1",
                name: "Daihatsu Xenia Silver",
                year: "2016",
                transmission: "Manual",
                seats: "7 Kursi",
                price: 300000,
                status: "Tersedia",
                image: "https://images.unsplash.com/photo-1549399542-7e3f8b79c341?w=600"
            },
            {
                id: "2",
                name: "Toyota Avanza Grand New",
                year: "2018",
                transmission: "Manual",
                seats: "7 Kursi",
                price: 350000,
                status: "Tersedia",
                image: "https://images.unsplash.com/photo-1552519507-da3b142c6e3d?w=600"
            },
            {
                id: "3",
                name: "Honda Brio Satya",
                year: "2020",
                transmission: "Matic",
                seats: "5 Kursi",
                price: 300000,
                status: "Tersewa",
                image: "https://images.unsplash.com/photo-1590362891991-f776e747a588?w=600"
            }
        ];

        function getCars() {
            const stored = localStorage.getItem('mustang_cars');
            return stored ? JSON.parse(stored) : defaultCars;
        }

        function saveCarsToStorage(cars) {
            localStorage.setItem('mustang_cars', JSON.stringify(cars));
        }

        let currentFilter = 'all';
        let searchQuery = '';

        function renderCars() {
            const cars = getCars();
            const grid = document.getElementById('carGrid');
            grid.innerHTML = '';

            let filteredCars = cars;
            if (currentFilter !== 'all') {
                filteredCars = filteredCars.filter(c => c.transmission === currentFilter);
            }
            if (searchQuery.trim() !== '') {
                filteredCars = filteredCars.filter(c => c.name.toLowerCase().includes(searchQuery.toLowerCase()));
            }

            if (filteredCars.length === 0) {
                grid.innerHTML = `<div class="col-span-full text-center py-12 text-slate-500 text-xs">Tidak ada unit mobil yang sesuai.</div>`;
                return;
            }

            filteredCars.forEach(car => {
                const isAvailable = car.status === 'Tersedia';

                grid.innerHTML += `
                    <div class="bg-slate-950 border border-slate-800 rounded-2xl overflow-hidden hover:border-slate-700/80 transition duration-300 group flex flex-col shadow-xl">
                        <div class="relative h-48 bg-slate-900 overflow-hidden">
                            <img src="${car.image || 'https://images.unsplash.com/photo-1549399542-7e3f8b79c341?w=600'}" alt="${car.name}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                            <span class="absolute top-3 right-3 text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-lg border ${
                                isAvailable 
                                ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/40 backdrop-blur-md' 
                                : 'bg-rose-500/20 text-rose-400 border-rose-500/40 backdrop-blur-md'
                            }">
                                ${car.status}
                            </span>
                        </div>
                        <div class="p-5 flex-grow flex flex-col justify-between">
                            <div>
                                <div class="flex justify-between items-start mb-2">
                                    <h4 class="text-base font-bold text-white group-hover:text-amber-400 transition">${car.name}</h4>
                                    <span class="text-[11px] text-amber-400 font-semibold bg-amber-400/10 px-2 py-0.5 rounded-md border border-amber-500/20">${car.year}</span>
                                </div>
                                <div class="flex items-center gap-3 text-xs text-slate-400 mb-4">
                                    <span><i class="fa-solid fa-gears text-amber-400 mr-1"></i> ${car.transmission}</span>
                                    <span>•</span>
                                    <span><i class="fa-solid fa-users text-amber-400 mr-1"></i> ${car.seats}</span>
                                </div>
                            </div>
                            <div class="pt-3 border-t border-slate-900 flex items-center justify-between mt-2">
                                <div>
                                    <span class="text-[10px] text-slate-500 block">Tarif Sewa Harian</span>
                                    <span class="text-base font-black text-amber-400">Rp ${Number(car.price).toLocaleString('id-ID')}</span>
                                    <span class="text-[10px] text-slate-400">/24 Jam</span>
                                </div>
                                <button onclick="openBookingModal('${car.id}', '${car.name}', ${car.price})" class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-4 py-2 rounded-xl transition text-xs flex items-center gap-1.5 shadow-md shadow-amber-500/10">
                                    <i class="fa-solid fa-file-signature text-sm"></i> Sewa Sekarang
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            });
        }

        // TANGGAL SEWA & MODAL SEWA
        function openBookingModal(id, name, price) {
            document.getElementById('bookCarId').value = id;
            document.getElementById('modalCarName').innerText = `Formulir Sewa: ${name}`;
            document.getElementById('bookCarPrice').value = price;
            
            // Set tanggal default (Hari ini & besok)
            const today = new Date().toISOString().split('T')[0];
            const tomorrow = new Date(Date.now() + 86400000).toISOString().split('T')[0];
            document.getElementById('startDate').value = today;
            document.getElementById('endDate').value = tomorrow;
            
            calculateRentalDays();
            document.getElementById('bookingModal').classList.remove('hidden');
        }

        function closeBookingModal() {
            document.getElementById('bookingModal').classList.add('hidden');
        }

        function calculateRentalDays() {
            const start = new Date(document.getElementById('startDate').value);
            const end = new Date(document.getElementById('endDate').value);
            const price = Number(document.getElementById('bookCarPrice').value);

            if (start && end && end >= start) {
                const diffTime = Math.abs(end - start);
                let diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                if (diffDays === 0) diffDays = 1;

                const totalCost = diffDays * price;
                document.getElementById('totalDaysText').innerText = `${diffDays} Hari`;
                document.getElementById('totalCostText').innerText = `Rp ${totalCost.toLocaleString('id-ID')}`;
            } else {
                document.getElementById('totalDaysText').innerText = `Tanggal Tidak Valid`;
                document.getElementById('totalCostText').innerText = `Rp 0`;
            }
        }

        // PREVIEW UPLOAD IDENTITAS & VALIDASI FOTO
        let uploadedFiles = { ktp: false, sim: false, selfie: false };

        function previewUpload(type, event) {
            if (event.target.files && event.target.files[0]) {
                uploadedFiles[type] = true;
                document.getElementById(`${type}Preview`).classList.remove('hidden');

                // Simulasi deteksi verifikasi foto
                if (uploadedFiles.ktp && uploadedFiles.selfie) {
                    // Random check / simulasi pengujian kualitas foto
                    const alertBox = document.getElementById('faceMatchAlert');
                    alertBox.classList.add('hidden');
                }
            }
        }

        function submitBookingAgreement(e) {
            e.preventDefault();

            if (!uploadedFiles.ktp || !uploadedFiles.sim || !uploadedFiles.selfie) {
                alert('Wajib mengunggah kelengkapan foto KTP, SIM A, dan Foto Selfie!');
                return;
            }

            const carName = document.getElementById('modalCarName').innerText.replace('Formulir Sewa: ', '');
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;
            const daysText = document.getElementById('totalDaysText').innerText;
            const totalCost = document.getElementById('totalCostText').innerText;
            const name = document.getElementById('renterName').value;
            const phone = document.getElementById('renterPhone').value;
            const address = document.getElementById('renterAddress').value;

            const message = encodeURIComponent(
                `*PENGAJUAN SEWA ONLINE - MUSTANG RENT CAR*\n` +
                `------------------------------------\n` +
                `• Unit: ${carName}\n` +
                `• Tanggal Sewa: ${startDate} s/d ${endDate} (${daysText})\n` +
                `• Total Biaya: ${totalCost}\n\n` +
                `*DATA IDENTITAS PENYEWA:*\n` +
                `• Nama: ${name}\n` +
                `• No. HP: ${phone}\n` +
                `• Alamat: ${address}\n` +
                `• Status Dokumen: E-KTP, SIM A, & Selfie Terlampir\n` +
                `• Surat Perjanjian: Disetujui (Online Signed)\n\n` +
                `Mohon dikonfirmasi unitnya, terima kasih!`
            );

            window.open(`https://wa.me/6281234567890?text=${message}`, '_blank');
            closeBookingModal();
        }

        // PENGADUAN
        function toggleComplaintModal() {
            document.getElementById('complaintModal').classList.toggle('hidden');
        }

        function submitComplaint(e) {
            e.preventDefault();
            const name = document.getElementById('compName').value;
            const category = document.getElementById('compCategory').value;
            const detail = document.getElementById('compDetail').value;

            const text = encodeURIComponent(
                `*PENGADUAN KONSUMEN - MUSTANG RENT CAR*\n` +
                `------------------------------------\n` +
                `• Nama: ${name}\n` +
                `• Kategori: ${category}\n` +
                `• Detail Keluhan:\n"${detail}"\n\n` +
                `Mohon tim Mustang Rent Car menindaklanjuti pengaduan ini.`
            );

            window.open(`https://wa.me/6281234567890?text=${text}`, '_blank');
            toggleComplaintModal();
        }

        // SEARCH & FILTER
        function handleSearch() {
            searchQuery = document.getElementById('searchInput').value;
            renderCars();
        }

        function filterCars(type) {
            currentFilter = type;
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('bg-amber-500', 'text-slate-950', 'font-bold');
                btn.classList.add('text-slate-400');
            });
            event.target.classList.remove('text-slate-400');
            event.target.classList.add('bg-amber-500', 'text-slate-950', 'font-bold');
            renderCars();
        }

        // ADMIN
        function toggleAdminModal() {
            document.getElementById('adminAuthModal').classList.toggle('hidden');
        }

        function handleAdminLogin(e) {
            e.preventDefault();
            const pin = document.getElementById('adminPin').value;
            if (pin === '1234') {
                toggleAdminModal();
                document.getElementById('adminDashboardModal').classList.remove('hidden');
                renderAdminCarList();
                document.getElementById('adminPin').value = '';
            } else {
                alert('PIN Admin Salah! (PIN Default: 1234)');
            }
        }

        function closeAdminDashboard() {
            document.getElementById('adminDashboardModal').classList.add('hidden');
        }

        function renderAdminCarList() {
            const cars = getCars();
            const list = document.getElementById('adminCarList');
            list.innerHTML = '';

            cars.forEach(car => {
                list.innerHTML += `
                    <div class="bg-slate-950 border border-slate-800 p-3 rounded-xl flex items-center justify-between gap-3 text-xs">
                        <div class="flex items-center gap-3">
                            <img src="${car.image || 'https://images.unsplash.com/photo-1549399542-7e3f8b79c341?w=600'}" class="w-12 h-12 rounded-lg object-cover">
                            <div>
                                <h5 class="font-bold text-white">${car.name} (${car.year})</h5>
                                <p class="text-slate-400">Rp ${Number(car.price).toLocaleString('id-ID')} - ${car.transmission}</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="toggleCarStatus('${car.id}')" class="px-2.5 py-1 rounded-lg font-semibold ${car.status === 'Tersedia' ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-rose-500/20 text-rose-400 border border-rose-500/30'}">
                                ${car.status}
                            </button>
                            <button onclick="deleteCar('${car.id}')" class="bg-slate-900 hover:bg-rose-600 text-slate-400 hover:text-white p-2 rounded-lg transition border border-slate-800">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </div>
                `;
            });
        }

        function saveCar(e) {
            e.preventDefault();
            const cars = getCars();
            const newCar = {
                id: Date.now().toString(),
                name: document.getElementById('carName').value,
                year: document.getElementById('carYear').value,
                transmission: document.getElementById('carTransmission').value,
                seats: document.getElementById('carSeats').value,
                price: Number(document.getElementById('carPrice').value),
                status: 'Tersedia',
                image: document.getElementById('carImage').value || 'https://images.unsplash.com/photo-1549399542-7e3f8b79c341?w=600'
            };

            cars.unshift(newCar);
            saveCarsToStorage(cars);
            renderCars();
            renderAdminCarList();
            e.target.reset();
            alert('Mobil baru berhasil ditambahkan!');
        }

        function toggleCarStatus(id) {
            const cars = getCars();
            const index = cars.findIndex(c => c.id.toString() === id.toString());
            if (index !== -1) {
                cars[index].status = cars[index].status === 'Tersedia' ? 'Tersewa' : 'Tersedia';
                saveCarsToStorage(cars);
                renderCars();
                renderAdminCarList();
            }
        }

        function deleteCar(id) {
            if (confirm('Yakin ingin menghapus unit mobil ini dari katalog?')) {
                let cars = getCars();
                cars = cars.filter(c => c.id.toString() !== id.toString());
                saveCarsToStorage(cars);
                renderCars();
                renderAdminCarList();
            }
        }

        // Init
        renderCars();
    </script>
</body>
</html>
